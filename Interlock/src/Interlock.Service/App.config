<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!--
    The two External Control services Setup Center calls. ExternalControlHost reads this section; the service names are the full
    names of the implementation types. Which binding Setup Center uses is an open question of the site checklist, so it is set
    here and not in code.

    Default: basicHttpBinding on http://localhost:8091 (one URL per service), each with a mex endpoint.
    Start-up replaces localhost with the machine name and logs every listen address.
    An http address needs a URL ACL for the service account (run once, as administrator):
      netsh http add urlacl url=http://+:8091/Interlock/ user=DOMAIN\serviceaccount

    To switch to net.tcp on site (no URL ACL needed), exactly:
      1. Delete the active services element below (the one that starts right after the system.serviceModel start tag).
      2. Remove the comment markers around the block named NETTCP-ALTERNATIVE (it holds its own services element).
         Leave the bindings and behaviors sections as they are: they already hold the net.tcp binding "ExternalControlTcp"
         and the behavior "ExternalControlTcpBehavior" (no HTTP GET, which needs an http base address).
      3. Change the two ports if 8092 or 8093 are taken. Every service needs its own port.
      4. Restart the service.
    Other bindings (for example wsHttpBinding) follow the same pattern: a binding section under bindings, a
    bindingConfiguration that names a section of the SAME binding type, and a behavior without HTTP GET for non-http schemes.

    After any change, register the mex addresses (base address plus /mex, with the machine name that the start-up log shows) in
    Factory Explorer > Service Configuration as SIPLACE.SetupCenter.ExternalControl and SIPLACE.Feeder.ExternalControl.
  -->
  <system.serviceModel>
    <services>
      <service name="Interlock.Service.ExternalControl.SetupCenterExternalControlService" behaviorConfiguration="ExternalControlBehavior">
        <host>
          <baseAddresses>
            <add baseAddress="http://localhost:8091/Interlock/SetupCenterExternalControl" />
          </baseAddresses>
        </host>
        <endpoint address="" binding="basicHttpBinding" bindingConfiguration="ExternalControlHttp"
                  contract="www.siplace.com.OIB._2008._05.SetupCenter.Contracts.Service.ISiplaceSetupCenterExternalControl" />
        <endpoint address="mex" binding="mexHttpBinding" contract="IMetadataExchange" />
      </service>
      <service name="Interlock.Service.ExternalControl.FeederExternalControlService" behaviorConfiguration="ExternalControlBehavior">
        <host>
          <baseAddresses>
            <add baseAddress="http://localhost:8091/Interlock/FeederExternalControl" />
          </baseAddresses>
        </host>
        <endpoint address="" binding="basicHttpBinding" bindingConfiguration="ExternalControlHttp"
                  contract="www.siplace.com.OIB._2008._05.SetupCenter.Contracts.Service.ISiplaceFeederExternalControl" />
        <endpoint address="mex" binding="mexHttpBinding" contract="IMetadataExchange" />
      </service>
    </services>

    <!--NETTCP-ALTERNATIVE
    <services>
      <service name="Interlock.Service.ExternalControl.SetupCenterExternalControlService" behaviorConfiguration="ExternalControlTcpBehavior">
        <host>
          <baseAddresses>
            <add baseAddress="net.tcp://localhost:8092/Interlock/SetupCenterExternalControl" />
          </baseAddresses>
        </host>
        <endpoint address="" binding="netTcpBinding" bindingConfiguration="ExternalControlTcp"
                  contract="www.siplace.com.OIB._2008._05.SetupCenter.Contracts.Service.ISiplaceSetupCenterExternalControl" />
        <endpoint address="mex" binding="mexTcpBinding" contract="IMetadataExchange" />
      </service>
      <service name="Interlock.Service.ExternalControl.FeederExternalControlService" behaviorConfiguration="ExternalControlTcpBehavior">
        <host>
          <baseAddresses>
            <add baseAddress="net.tcp://localhost:8093/Interlock/FeederExternalControl" />
          </baseAddresses>
        </host>
        <endpoint address="" binding="netTcpBinding" bindingConfiguration="ExternalControlTcp"
                  contract="www.siplace.com.OIB._2008._05.SetupCenter.Contracts.Service.ISiplaceFeederExternalControl" />
        <endpoint address="mex" binding="mexTcpBinding" contract="IMetadataExchange" />
      </service>
    </services>
    NETTCP-ALTERNATIVE-->

    <bindings>
      <!-- Message size and reader quotas as in the OIB proxy configuration files (a station start sends every feeder of the table). -->
      <basicHttpBinding>
        <binding name="ExternalControlHttp" maxReceivedMessageSize="2000000000" maxBufferSize="2000000000">
          <readerQuotas maxDepth="2147483647" maxStringContentLength="2147483647" maxArrayLength="2147483647" maxBytesPerRead="2147483647" maxNameTableCharCount="2147483647" />
          <security mode="None" />
        </binding>
      </basicHttpBinding>
      <!-- Used only by the net.tcp alternative above. -->
      <netTcpBinding>
        <binding name="ExternalControlTcp" maxReceivedMessageSize="2000000000" maxBufferSize="2000000000">
          <readerQuotas maxDepth="2147483647" maxStringContentLength="2147483647" maxArrayLength="2147483647" maxBytesPerRead="2147483647" maxNameTableCharCount="2147483647" />
          <security mode="None" />
        </binding>
      </netTcpBinding>
    </bindings>

    <behaviors>
      <serviceBehaviors>
        <behavior name="ExternalControlBehavior">
          <serviceMetadata httpGetEnabled="true" />
        </behavior>
        <!-- Used only by the net.tcp alternative above: metadata over the mex endpoint only. -->
        <behavior name="ExternalControlTcpBehavior">
          <serviceMetadata />
        </behavior>
      </serviceBehaviors>
    </behaviors>
  </system.serviceModel>
</configuration>
