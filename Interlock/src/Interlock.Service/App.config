<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!--
    The two External Control services Setup Center calls (ExternalControlHost reads this section; the service names are the full
    names of the implementation types). Which binding Setup Center uses is an open question of the site checklist, so it is set
    here and not in code. To change it on site:
      1. In each <service>, set the baseAddress scheme and the binding of both endpoints, e.g. wsHttpBinding for http://... or
         netTcpBinding for net.tcp://... (the mex endpoint follows: mexHttpBinding for http, mexTcpBinding for net.tcp).
      2. If the new binding needs settings, add a <binding> for it under <bindings> and name it in bindingConfiguration.
      3. Restart the service. Register the new mex address (<baseAddress>/mex, with localhost replaced by the machine name, as
         logged at start) in Factory Explorer > Service Configuration as SIPLACE.SetupCenter.ExternalControl and
         SIPLACE.Feeder.ExternalControl.
    http addresses need a URL ACL for the service account, e.g.:
      netsh http add urlacl url=http://+:8091/Interlock/ user=DOMAIN\serviceaccount
  -->
  <system.serviceModel>
    <services>
      <service name="Interlock.Service.ExternalControl.SetupCenterExternalControlService" behaviorConfiguration="ExternalControlBehavior">
        <host>
          <baseAddresses>
            <add baseAddress="http://localhost:8091/Interlock/SetupCenterExternalControl" />
          </baseAddresses>
        </host>
        <endpoint address="" binding="basicHttpBinding" bindingConfiguration="ExternalControlHttp"
                  contract="www.siplace.com.OIB._2008._05.SetupCenter.Contracts.Service.ISiplaceSetupCenterExternalControl" />
        <endpoint address="mex" binding="mexHttpBinding" contract="IMetadataExchange" />
      </service>
      <service name="Interlock.Service.ExternalControl.FeederExternalControlService" behaviorConfiguration="ExternalControlBehavior">
        <host>
          <baseAddresses>
            <add baseAddress="http://localhost:8091/Interlock/FeederExternalControl" />
          </baseAddresses>
        </host>
        <endpoint address="" binding="basicHttpBinding" bindingConfiguration="ExternalControlHttp"
                  contract="www.siplace.com.OIB._2008._05.SetupCenter.Contracts.Service.ISiplaceFeederExternalControl" />
        <endpoint address="mex" binding="mexHttpBinding" contract="IMetadataExchange" />
      </service>
    </services>

    <bindings>
      <!-- Message size and reader quotas as in the OIB proxy configuration files (a station start sends every feeder of the table). -->
      <basicHttpBinding>
        <binding name="ExternalControlHttp" maxReceivedMessageSize="2000000000" maxBufferSize="2000000000">
          <readerQuotas maxDepth="2147483647" maxStringContentLength="2147483647" maxArrayLength="2147483647" maxBytesPerRead="2147483647" maxNameTableCharCount="2147483647" />
          <security mode="None" />
        </binding>
      </basicHttpBinding>
    </bindings>

    <behaviors>
      <serviceBehaviors>
        <behavior name="ExternalControlBehavior">
          <serviceMetadata httpGetEnabled="true" />
        </behavior>
      </serviceBehaviors>
    </behaviors>
  </system.serviceModel>
</configuration>
