<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <appSettings>
    <!-- Endpoint of the SetupCenter adapter (can be either in this app config file or set programmatically)-->
    <!-- When set via the application config the adapter host should be replace with the host name of the computer hosting the SetupCenter adapter -->
    <add key="Asm.As.Oib.SetupCenter.Proxy.Endpoint" value="net.tcp://adapterhost:1406/Asm.As.Oib.SetupCenter/SiplaceSetupCenter/Reliable" />
    <!-- When set to true, uses the secure endpoint which provides encrypted, secured communication (default is false)-->
    <add key="Asm.As.Oib.SetupCenter.Proxy.UseSecureCoreEndpoints" value="true" />
    <!-- If you want to define the name of the core computer in the config file; use the 
    following line and specify the core computer name -->
    <!-- When set via the application config the core host should be replace with the host name of the ASM OIB Core -->
    <!-- When using the defaulr constructor SiplaceSetupCenter() and the CoreName is provided, a event subscription is created in the constructor logic -->
    <add key="Asm.As.Oib.SetupCenter.Proxy.CoreName" value="corehost" />
    <!--When providing the CallbackName, this will be part of the callback uri-->
    <!--Is highly recommended since then the subscription can be identified more easily-->
    <add key="Asm.As.Oib.SetupCenter.Proxy.CallbackName" value="MyApplicationName" />
    <!--This is the port that will be used to host the callback (if not provided 45535 is used)-->
    <add key="Asm.As.Oib.SetupCenter.Proxy.CallbackPortNumber" value="45535" />
    <!--This specifies if a net.tcp or a http callback endpoint is used (if not provided, true is used)-->
    <add key="Asm.As.Oib.SetupCenter.Proxy.UseCallbackTcpEndpoint" value="true" />
    <!--This specifies the interval in ms for checking connectivity to the service. Default value is 60000 (1 minute) -->
    <add key="Asm.As.Oib.SetupCenter.Proxy.CheckConnectionStateFrequency" value="60000" />
    <!-- When set to true, uses the secure endpoints to communicate to the OIB core for the subscription(default is false)-->
    <add key="Asm.As.Oib.SetupCenter.Proxy.UseSecureCoreEndpoints" value="true" />
    <!-- When set to true, uses the tcp port sharing service to host the callback (default is true). For non-admin processes, use false.-->
    <add key="Asm.As.Oib.Proxies.TcpPortSharingEnabled" value="false" />
    <!--If TcpPortSharingEnabled is set to false, you can restrict the tcp ports being used by this setting.
    Used ports will start at the given port of the Callback Base up to the base port number + this number.
    If set to 0 (default), the number is unlimited-->
    <add key="Asm.As.Oib.Proxies.TcpPortBandwidth" value="100" />
    <!--These are values a user can override if necessary (for info see MSDN for binding parameters),
    if they are not provided then the defaults are used-->
    <add key="Asm.As.Oib.SetupCenter.Proxy.OpenTimeout" value="00:00:30" />
    <add key="Asm.As.Oib.SetupCenter.Proxy.SendTimeout" value="00:10:00" />
    <add key="Asm.As.Oib.SetupCenter.Proxy.CloseTimeout" value="00:00:10" />
    <!--***********************************************************************************************************-->
    <!--********************************* Used for OIB Client authentication **************************************-->
    <!--***********************************************************************************************************-->
    <!-- These Client certificate parameters are used in all proxies and the "ClientCertificateValue" 
         must be adapted to a certificate selected during OIB installation. Those can also be set in 
         source code using the proxy interface, but consider thereby these app.config settings will then be overridden.-->
    <!-- IMPOPRTANT: Use either Global or Proxy specific -->
    <!-- Option 1.) Global client authentication parameters, used for all proxies (SC, SPI, etc.) and channels -->
    <!--
    <add key="Asm.As.Oib.ClientCertificateValue" value="CN=ASM.SW.Client" />
    <add key="Asm.As.Oib.ClientCertificateStoreLocation" value="CurrentUser" />
    <add key="Asm.As.Oib.ClientCertificateStoreName" value="My" />
    <add key="Asm.As.Oib.ClientCertificateX509FindType" value="FindBySubjectDistinguishedName" />
    -->
    <!--***********************************************************************************************************-->
    <!-- Option 2.) Proxy specific client authentication parameters -->
    <!-- IMPORTANT: These settings override the global settings (Option 1)-->
    <!--
    <add key="Asm.As.Oib.SetupCenter.Proxy.ClientCertificateValue" value="CN=ASM.SW.Client" />
    <add key="Asm.As.Oib.SetupCenter.Proxy.ClientCertificateStoreLocation" value="CurrentUser" />
    <add key="Asm.As.Oib.SetupCenter.Proxy.ClientCertificateStoreName" value="My" />
    <add key="Asm.As.Oib.SetupCenter.Proxy.ClientCertificateX509FindType" value="FindBySubjectDistinguishedName" />
    -->
    <!--**************************************************************************************************************-->
  </appSettings>
</configuration>