<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <appSettings>
    <!--Endpoint of the optimizer adapter (can be either in this app config file or set programmatically)-->
    <!-- When set via the application config the 'adapterhost' should be replaced with the host name of the Optimizer Adapter computer -->
    <add key="Asm.As.Oib.SiplacePro.Optimizer.Proxy.Endpoint" value="net.tcp://adapterhost:1406/Asm.As.Oib.SiplacePro.Optimizer/Secure" />
    <!--Endpoint to be opened by the optimizer adapter smart proxy to receive events.-->
    <!--Rename MyApplicationName to your application name or another unique name-->
    <add key="Asm.As.Oib.SiplacePro.Optimizer.Proxy.CallbackEndpointBase" value="net.tcp://localhost:47684/MyApplicationName" />
    <!--Port number to be used by endpoint opened by the optimizer smart proxy to host another service called ClientStatusService .-->
    <add key="Asm.As.Oib.Proxies.ClientStatusCallbackPort" value="41234" />
    <!--These are values a user can override if necessary (for info see MSDN for binding parameters),
    if they are not provided then the defaults are used-->
    <add key="Asm.As.Oib.SiplacePro.Optimizer.Proxy.OpenTimeout" value="00:00:30" />
    <add key="Asm.As.Oib.SiplacePro.Optimizer.Proxy.SendTimeout" value="00:30:00" />
    <add key="Asm.As.Oib.SiplacePro.Optimizer.Proxy.CloseTimeout" value="00:00:10" />
    <!--This is for the reliable channel implementation, in this example the proxy will retry for a minute-->
    <add key="Asm.As.Oib.SiplacePro.Proxies.ReliableChannel.MaxNumberOfRetryAttempts" value="30" />
    <!--This is for the reliable channel implementation, RetryFrequency in ms -->
    <add key="Asm.As.Oib.SiplacePro.Proxies.ReliableChannel.RetryFrequency" value="2000" />
    <!--This is the interval in ms when the proxy checks the connection to the Service,
    it must be greater or equal to 1000ms; if this is not present, a default value of 1 minute is used -->
    <add key="Asm.As.Oib.SiplacePro.Proxies.ReliableChannel.CheckAliveFrequency" value="60000" />
    <!--If this is set to false, the client callback services will not use the tcp port sharing.
    By default (if not specified), this is true. 
    In general one reason not to use port sharing is a administration of permissions for the port sharing service .
    This must be done on a per user basis in the port sharing service. See MSDN for details. 
 
    Enabling Port Sharing for users and applications not running as local administrators
      - Edit C:\WINDOWS\WinFX\v3.0\Windows Communication
        Foundation\SMSvcHost.exe.config and add the following config section:

          <configuration>
          <system.serviceModel.activation>
          <net.tcp>
          <allowAccounts>
          <add securityIdentifier="S-1-5-your sid here"/>
          </allowAccounts>
          </net.tcp>
          </system.serviceModel.activation>
          .....
          </configuration>

    Basically, replace "S-1-5-your sid here" with the SID of the non-domain
    admin group/user that you want to be able to use for running the WCF service
    on the network.
 
    If you do not want that changes on this location, please do not use port sharing for the callback 
    mechanism. 
    
    This setting is valid for the Optimizer Proxy, LineControl Proxy, Monitoring Proxy, Factory Calendar Proxy
    and Configuration Manager Proxy.-->
    <add key="Asm.As.Oib.Proxies.TcpPortSharingEnabled" value="false" />
    <!--If TcpPortSharingEnabled is set to false, you can restrict the tcp ports being used by this setting.
    Used ports will start at the given port of the Callback Base up to the base port number + this number.
    If set to 0 (default), the number is unlimited-->
    <add key="Asm.As.Oib.Proxies.TcpPortBandwidth" value="100" />
    <!--***********************************************************************************************************-->
    <!--********************************* Used for OIB Client authentication **************************************-->
    <!--***********************************************************************************************************-->
    <!-- These Client certificate parameters are used in all proxies and the "ClientCertificateValue" 
         must be adapted to a certificate selected during OIB installation. Those can also be set in 
         source code using the proxy interface, but consider thereby these app.config settings will then be overridden.-->
    <!-- IMPOPRTANT: Use either Global or Proxy specific -->
    <!-- Option 1.) Global client authentication parameters, used for all proxies (SC, SPI, etc.) and channels -->
    <!--
    <add key="Asm.As.Oib.ClientCertificateValue" value="CN=ASM.SW.Client" />
    <add key="Asm.As.Oib.ClientCertificateStoreLocation" value="CurrentUser" />
    <add key="Asm.As.Oib.ClientCertificateStoreName" value="My" />
    <add key="Asm.As.Oib.ClientCertificateX509FindType" value="FindBySubjectDistinguishedName" />
    -->
    <!--***********************************************************************************************************-->
    <!-- Option 2.) Proxy specific client authentication parameters -->
    <!-- IMPORTANT: These settings override the global settings (Option 1)-->
    <!--
    <add key="Asm.As.Oib.SiplacePro.Optimizer.Proxy.ClientCertificateValue" value="CN=ASM.SW.Client" />
    <add key="Asm.As.Oib.SiplacePro.Optimizer.Proxy.ClientCertificateStoreLocation" value="CurrentUser" />
    <add key="Asm.As.Oib.SiplacePro.Optimizer.Proxy.ClientCertificateStoreName" value="My" />
    <add key="Asm.As.Oib.SiplacePro.Optimizer.Proxy.ClientCertificateX509FindType" value="FindBySubjectDistinguishedName" />
    -->
    <!--**************************************************************************************************************-->
  </appSettings>
</configuration>