<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!--
	
	This is an example app.config file if you intend to use the WCF proxy of the OIB SIPLACE Pro Line Control Adapter and 
	you decide for configuration file base configration.
	
	Replace "localhost" according to your deployment scenario.
	
	Hint: OIB SIPLACE Pro Line Control service supports also HTTP net.tcp protocol.
	
	-->
  <system.serviceModel>
    <bindings>
      <netTcpBinding>
        <binding name="NetTcpLineControlBinding" closeTimeout="01:00:00" openTimeout="01:00:00" receiveTimeout="10:00:00" sendTimeout="01:00:00" transactionFlow="false" hostNameComparisonMode="StrongWildcard" maxBufferPoolSize="524288" maxReceivedMessageSize="2147483647" portSharingEnabled="true">
          <readerQuotas maxDepth="2147483647" maxStringContentLength="2147483647" maxArrayLength="2147483647" maxBytesPerRead="2147483647" maxNameTableCharCount="2147483647" />
          <reliableSession ordered="true" inactivityTimeout="10:00:00" enabled="true" />
          <security mode="None" />
        </binding>
      </netTcpBinding>
    </bindings>
    <client>
      <!-- Replace localhost by the hostname the optimizer adapter is being installed -->
      <endpoint address="net.tcp://localhost:1406/Asm.As.Oib.SiplacePro.LineControl/Reliable" binding="netTcpBinding" bindingConfiguration="NetTcpLineControlBinding" contract="www.siplace.com.OIB._2008._05.SiplacePro.LineControl.Contracts.Service.ILineControl" name="NetTcpBinding_ILineControl" />
    </client>
  </system.serviceModel>
</configuration>