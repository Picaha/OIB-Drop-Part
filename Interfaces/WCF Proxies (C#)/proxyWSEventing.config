<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <system.serviceModel>
    <bindings>
      <wsHttpBinding>
        <binding name="WSHttpBindingConfig" closeTimeout="00:10:00" openTimeout="00:10:00" receiveTimeout="infinite" sendTimeout="01:00:00" bypassProxyOnLocal="true" maxReceivedMessageSize="2000000000" useDefaultWebProxy="false">
          <readerQuotas maxDepth="2147483647" maxStringContentLength="2147483647" maxArrayLength="2147483647" maxBytesPerRead="2147483647" maxNameTableCharCount="2147483647" />
          <reliableSession inactivityTimeout="00:10:00" enabled="true" />
          <security mode="None" />
        </binding>
      </wsHttpBinding>
      <netTcpBinding>
        <binding name="NetTcpBindingConfig" closeTimeout="00:10:00" openTimeout="00:10:00" receiveTimeout="infinite" sendTimeout="01:00:00" maxBufferSize="2000000000" maxReceivedMessageSize="2000000000" portSharingEnabled="true">
          <readerQuotas maxDepth="2147483647" maxStringContentLength="2147483647" maxArrayLength="2147483647" maxBytesPerRead="2147483647" maxNameTableCharCount="2147483647" />
          <reliableSession inactivityTimeout="00:10:00" enabled="true" />
          <security mode="None">
          </security>
        </binding>
      </netTcpBinding>
    </bindings>
    <client>
      <!-- HTTP Endpoint to subscribe for messages -->
      <endpoint address="http://localhost:1405/Asm.As.Oib.WS.Eventing.Services/SubscriptionManager/Reliable" binding="wsHttpBinding" bindingConfiguration="WSHttpBindingConfig" contract="schemas.xmlsoap.org.ws._2004._08.eventing.ISubscriptionManager" name="WSHttpBinding_IWSEventing" />
      <!-- HTTP Endpoint to post messages to the oib eventing system -->
      <endpoint address="http://localhost:1405/Asm.As.Oib.WS.Eventing.Services/NotificationManager/Reliable" binding="wsHttpBinding" bindingConfiguration="WSHttpBindingConfig" contract="schemas.xmlsoap.org.ws._2004._08.eventing.INotificationManager" name="WSHttpBinding_INotificationManager" />
      <!-- TCP Endpoint to subscribe for messages -->
      <!-- <endpoint address="http://localhost:1405/Asm.As.Oib.WS.Eventing.Services/SubscriptionManager/Reliable"
                     binding="wsHttpBinding" bindingConfiguration="WSHttpBindingConfig"
                     contract="schemas.xmlsoap.org.ws._2004._08.eventing.ISubscriptionManager"
                     name="WSHttpBinding_IWSEventing" /> -->
      <!-- TCP Endpoint to post messages to the oib eventing system -->
      <!-- <endpoint address="http://localhost:1405/Asm.As.Oib.WS.Eventing.Services/NotificationManager/Reliable"
                binding="wsHttpBinding" bindingConfiguration="WSHttpBindingConfig"
                contract="schemas.xmlsoap.org.ws._2004._08.eventing.INotificationManager"
                name="WSHttpBinding_INotificationManager" />-->
    </client>
  </system.serviceModel>
</configuration>