      </service>
      <service name="Put.Your.Class.Name.Here">
        <endpoint address="http://localhost:33334/OnObjectCreated" binding="wsHttpBinding" bindingConfiguration="WSHttpBinding_all" contract="Asm.As.Oib.ConfigurationManager.Contracts.Eventing.IObjectCreated" />
      </service>
    </services>
  </system.serviceModel>
</configuration>