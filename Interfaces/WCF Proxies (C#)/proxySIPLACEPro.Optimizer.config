<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!--
	
	This is an example app.config file if you intend to use the WCF proxy of the OIB SIPLACE Pro Optimizer Adapter and 
	you decide for configuration file base configration.
	
	Replace "localhost" according to your deployment scenario and "MyApp.OptimizerCallbackImplementation" according to 
	the type of the implementation of the callback interfaces.
	
	Hint: OIB SIPLACE Pro Optimizer service supports only net.tcp protocol and not reliable sessions.
	
	-->
  <system.serviceModel>
    <bindings>
      <netTcpBinding>
        <binding name="NetTcpOptimizerBinding" closeTimeout="01:00:00" openTimeout="01:00:00" receiveTimeout="10:00:00" sendTimeout="01:00:00" transactionFlow="false" hostNameComparisonMode="StrongWildcard" maxBufferPoolSize="524288" maxReceivedMessageSize="2147483647" portSharingEnabled="true">
          <readerQuotas maxDepth="2147483647" maxStringContentLength="2147483647" maxArrayLength="2147483647" maxBytesPerRead="2147483647" maxNameTableCharCount="2147483647" />
          <reliableSession ordered="true" inactivityTimeout="10:00:00" enabled="false" />
          <security mode="None" />
        </binding>
      </netTcpBinding>
    </bindings>
    <client>
      <!-- Replace localhost by the hostname the optimizer adapter is being installed -->
      <endpoint address="net.tcp://localhost:1406/Asm.As.Oib.SiplacePro.Optimizer" binding="netTcpBinding" bindingConfiguration="NetTcpOptimizerBinding" contract="www.siplace.com.OIB._2008._05.SiplacePro.Optimizer.Contracts.Service.IOptimizer" name="NetTcpBinding_IOptimizer" />
      <endpoint address="net.tcp://localhost:1406/Asm.As.Oib.SiplacePro.Optimizer/Cluster" binding="netTcpBinding" bindingConfiguration="NetTcpOptimizerBinding" contract="www.siplace.com.OIB._2008._05.SiplacePro.Optimizer.Contracts.Service.IClusterOptimizer" name="NetTcpBinding_IClusterOptimizer" />
    </client>
    <services>
      <!-- This is the configuration to set up your callback service. Replace MyApp.OptimizerCallbackImplementation by the type of your IOptimizerNotify and ClusterOptimizerNotify implementation type -->
      <service name="MyApp.OptimizerCallbackImplementation">
        <host>
          <baseAddresses>
            <!-- Replace localhost by the hostname of the computer this application is being deployed -->
            <add baseAddress="net.tcp://localhost:1406/MyApp" />
          </baseAddresses>
        </host>
        <endpoint address="OptimizerNotify" binding="netTcpBinding" bindingConfiguration="NetTcpOptimizerBinding" contract="www.siplace.com.OIB._2008._05.SiplacePro.Optimizer.Contracts.Service.IOptimizerNotify" />
        <endpoint address="ClusterOptimizerNotify" binding="netTcpBinding" bindingConfiguration="NetTcpOptimizerBinding" contract="www.siplace.com.OIB._2008._05.SiplacePro.Optimizer.Contracts.Service.IClusterOptimizerNotify" />
      </service>
    </services>
  </system.serviceModel>
</configuration>